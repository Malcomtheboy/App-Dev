# Server-only configuration. Never use EXPO_PUBLIC_ for these values.
PORT=3000
FIREBASE_PROJECT_ID=rihla-31cd5
GEMINI_API_KEY=
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# Basic Firebase ID-token verification uses public signing certificates and
# does not need a service-account private key. Leave FIREBASE_AUTH_EMULATOR_HOST
# unset: the Gemini API deliberately rejects Auth emulator mode.
