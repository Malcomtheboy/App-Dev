{
  "expo": {
    "name": "Rihla",
    "slug": "rihla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rihla",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rihla.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.rihla.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rihla uses your location to calculate accurate prayer times and point you toward the Qibla."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "dark": {
            "backgroundColor": "#00251D",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-font",
      "expo-audio",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/adhan.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
