rules_version = '2';

// PROPOSED rules — not deployed. Review against whatever is already live on
// the Firebase console (project rihla-31cd5) before replacing anything, since
// this file only knows about the two collections below.
//
// admins/{uid}
//   One doc per admin, doc ID = their Firebase Auth uid. A signed-in user may
//   read only their OWN doc (that's how the admin portal checks "am I an
//   admin"). Nobody can write through the client: add admins by hand in the
//   Firebase console or with the Admin SDK.
//
// users/{uid}
//   Written by the mobile app at sign-up (displayName, email, createdAt).
//   Each person can read and edit only their own doc; admins can read all of
//   them (the admin portal's Users page and account count).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
