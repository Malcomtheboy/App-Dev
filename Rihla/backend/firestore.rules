rules_version = '2';

// Mirrors the rules published to project rihla-31cd5 on 2026-10-17.
// This repository does not deploy rules automatically; compare the live rules
// before a future deployment so newer collections are not accidentally removed.
//
// admins/{uid}
//   One doc per admin, doc ID = their Firebase Auth uid. A signed-in user may
//   read only their OWN doc (that's how the admin portal checks "am I an
//   admin"). Nobody can write through the client: add admins by hand in the
//   Firebase console or with the Admin SDK.
//
// users/{uid}
//   Written by the mobile app at sign-up (displayName, email, createdAt).
//   Each person keeps the existing read/write access to their own document and
//   nested documents; admins can read root user docs for the Users page/count.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
