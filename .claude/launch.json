{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rihla-mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Rihla/apps/mobile", "run", "web"],
      "port": 8081
    },
    {
      "name": "rihla-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Rihla/apps/api", "run", "dev"],
      "port": 3000
    },
    {
      "name": "rihla-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Rihla/apps/admin", "run", "dev", "--", "-p", "3001"],
      "port": 3001
    }
  ]
}
